# ---- Alpaca API credentials (Crypto) ----
# Create on Alpaca (use paper keys while ALPACA_BASE_URL points at paper).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper trading by default. For live, set to https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Trading config ----
TRADING_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
QUOTE_CURRENCY=USD

# ---- Risk management ----
ACCOUNT_BASE=10000
BASE_RISK_PERCENT=0.01
MAX_SINGLE_TRADE_USD=150
MAX_PORTFOLIO_VALUE=500
MAX_OPEN_POSITIONS=3
MAX_DRAWDOWN_STOP=-10.0
DAILY_LOSS_LIMIT=-3.0

# ---- Strategy ----
PROFIT_TARGET_PCT=0.03
STOP_LOSS_PCT=0.02
ATR_STOP_MULTIPLIER=2.0
MAX_HOLD_HOURS=8.0
DUST_VALUE_USD=1.50

# ---- Regime classification thresholds ----
HURST_TREND_UP=0.52
HURST_MEAN_REVERT=0.48
HIGH_VOLATILITY_PCT=5.0
RSI_OVERBOUGHT=70.0
RSI_OVERSOLD=30.0
RSI_NEUTRAL_BUY=35.0
RSI_NEUTRAL_SELL=65.0

# ---- Trailing stop ----
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=0.015
TRAILING_DISTANCE_PCT=0.01

# ---- Loop / server ----
LOOP_INTERVAL_SEC=60
STATUS_PORT=8080
BOT_NAME=apex_oracle_bot

# ---- Optional: persistence (leave default for SQLite) ----
# DATABASE_URL=sqlite:////app/data/trades.db

# ---- Optional: Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: Base44 dashboard ----
DASHBOARD_API_KEY=
BASE44_API_URL=https://api.base44.com/api/apps/YOUR_APP_ID/entities