# ==============================================================================
# Apex Oracle Bot - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
#
#   cp .env.example .env
#
# ==============================================================================

# --- Alpaca Broker API Credentials (Required for Live / Paper Trading) ---
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
# Base URL: Use paper-api for testing, api for live trading
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Database Connection (Optional - defaults to SQLite at data/bot.db) ---
DATABASE_URL=sqlite:///data/bot.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading_bot

# --- Dashboard & Notifications (Optional) ---
# Base44 Dashboard Integration
DASHBOARD_API_KEY=
BASE44_API_URL=https://api.base44.com/api/apps/YOUR_APP_ID/entities

# Telegram Real-Time Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading Configurations ---
# Comma-separated list of crypto assets to trade
TRADING_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
QUOTE_CURRENCY=USD

# --- Risk Management Limits ---
# Account base value used for per-trade percentage sizing ($)
ACCOUNT_BASE=10000.0
# Standard risk per trade (0.01 = 1%)
BASE_RISK_PERCENT=0.01
# Maximum dollar allocation per individual trade ($)
MAX_SINGLE_TRADE_USD=2500.0
# Maximum cumulative portfolio exposure ($)
MAX_PORTFOLIO_VALUE=500.0
# Maximum concurrent open positions
MAX_OPEN_POSITIONS=3
# Portfolio drawdown limit percentage to trigger killswitch (-10.0 = -10%)
MAX_DRAWDOWN_STOP=-10.0
# Daily total loss limit percentage (-3.0 = -3%)
DAILY_LOSS_LIMIT=-3.0
# How often (seconds) the killswitch monitor polls account status. Each check
# is a full Alpaca round-trip, so this is the worst-case detection lag for a
# drawdown/daily-loss breach.
KILLSWITCH_CHECK_INTERVAL_SEC=5.0

# --- Strategy Parameters ---
# Take-profit target percentage (0.03 = 3%)
PROFIT_TARGET_PCT=0.03
# Stop-loss percentage (0.04 = 4%)
STOP_LOSS_PCT=0.04
# ATR multiplier for volatility sizing
ATR_STOP_MULTIPLIER=2.0
# Maximum hours to hold an open position before forced exit
MAX_HOLD_HOURS=8.0
# Position market value ($) below which position is considered dust
DUST_VALUE_USD=1.50

# --- Trailing Stop Parameters ---
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=0.04
TRAILING_DISTANCE_PCT=0.03

# --- Regime Classification Thresholds ---
# Hurst exponent threshold for trending classification (adjusted for R/S estimator bias)
HURST_TREND_UP=0.60
# Hurst exponent threshold for mean-reversion classification
HURST_MEAN_REVERT=0.58
# High volatility ATR percentage ceiling (triggers stand-aside mode)
HIGH_VOLATILITY_PCT=5.0
# RSI threshold levels
RSI_OVERBOUGHT=80.0
RSI_OVERSOLD=30.0
RSI_NEUTRAL_BUY=45.0
RSI_NEUTRAL_SELL=55.0
# --- Adaptive Meta-Learner (self-evolving committee weighting) ---
# Learns which brain to trust per regime from realized outcomes. risk.py stays
# authoritative. Default is shadow mode (computed & logged, but not acted on).
ADAPTIVE_ML_ENABLED=false
ADAPTIVE_STATE_PATH=data/adaptive_meta_state.json
ADAPTIVE_LEARNING_RATE=0.10
ADAPTIVE_MIN_WEIGHT=0.02
ADAPTIVE_MAX_WEIGHT=0.60
# Realized outcomes required before learned weights drive live decisions
ADAPTIVE_MIN_TRADES_BEFORE_LIVE=50
