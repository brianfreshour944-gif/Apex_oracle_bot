# Copy this file to .env and fill in your credentials

# Alpaca (required for trading)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
# Use paper trading by default
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database (optional - defaults to local Postgres)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading_bot

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_API_KEY=

# Optional overrides
# TRADING_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
# LOOP_INTERVAL_SEC=60