   "source": [
    "# =====================================================================\n",
    "# Kaggle LLM Setup - Just run each cell in order\n",
    "# =====================================================================\n",
    "# This notebook sets up Qwen3-Coder-30B on Kaggle 2× T4 GPUs\n",
    "# and exposes it via a Cloudflare tunnel for remote access.\n",
    "\n",
    "print(\"🚀 Starting Kaggle LLM setup...\")\n",
    "print(\"This will take ~15 minutes on first run (builds CUDA llama.cpp)\")\n",
    "print(\"Model downloads 21GB - cached after first run\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# CELL 1: Clone repo & install dependencies\n",
    "# =====================================================================\n",
    "!git clone https://github.com/brianfreshour944-gif/Apex_oracle_bot.git\n",
    "%cd Apex_oracle_bot/kaggle_llm_pipeline\n",
    "\n",
    "# Verify we're in the right place\n",
    "import os\n",
    "print(f\"Working in: {os.getcwd()}\")\n",
    "print(f\"Files: {os.listdir('.')}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# CELL 2: Download model & build CUDA llama-server (~12 min first run)\n",
    "# =====================================================================\n",
    "MODEL = \"/kaggle/working/models/qwen3-coder-32b-q5_k_m.gguf\"\n",
    "MODEL_DIR = \"/kaggle/working/models\"\n",
    "\n",
    "import os, shutil, subprocess\n",
    "\n",
    "# 1. Download model from Hugging Face if not cached\n",
    "if not os.path.exists(\"MODEL\"):\n",
    "    print(f\"📥 Downloading 21GB model from Hugging Face...\")\n",
    "    !pip install -q -U huggingface_hub\n",
    "    import os, shutil\n",
    "    from huggingface_hub import hf_hub_download\n",
    "    path = hf_hub_download(\n",
    "        repo_id=\"unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF\",\n",
    "        filename=\"Qwen3-Coder-30B-A3B-Instruct-Q5_K_M.gguf\"\n",
    "    )",
    "    os.makedirs(MODEL_DIR, exist_ok=True)\n",
    "    shutil.copy(path, MODEL)\n",
    "    print(f\"✅ Model downloaded to {MODEL}\")\n",
    "else:\n",
    "    print(f\"✅ Model already cached at {MODEL}\")\n",
    "\n",
    "# 2. Build llama.cpp with CUDA support (skipped if binary exists)\n",
    "if not os.path.exists(\"./llama-cuda\"):\n",
    "    print(\"🔨 Building CUDA llama-server (this takes ~10-15 min)...\")\n",
    "    # Symlink driver lib where CMake expects it\n",
    "    os.system(\"ln -sf /usr/local/nvidia/lib64/libcuda.so /usr/local/cuda/lib64/libcuda.so\")\n",
    "    os.system(\"ln -sf /usr/local/nvidia/lib64/libcuda.so.1 /usr/local/cuda/lib64/libcuda.so.1\")\n",
    "    \n",
    "    # Build llama.cpp with CUDA\n",
    "    if not os.path.exists(\"cuda_src\"):\n",
    "        subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", \"https://github.com/ggml-org/llama.cpp.git\", \"cuda_src\"], check=True)\n",
    "    \n",
    "    cmake_cmd = [\n",
    "        \"cmake\", \"-S\", \"cuda_src\", \"-B\", \"cuda_build\",\n",
    "        \"-DGGML_CUDA=ON\",\n",
    "        \"-DLLAMA_CURL=OFF\",\n",
    "        \"-DCUDAToolkit_ROOT=/usr/local/cuda\"\n",
    "    ]\n",
    "    subprocess.run(cmake_cmd, check=True)\n",
    "    subprocess.run([\"cmake\", \"--build\", \"cuda_build\", \"--config\", \"Release\", \"-j4\", \"--target\", \"llama-server\"], check=True)\n",
    "    \n",
    "    # Copy binary\n",
    "    shutil.copy(\"cuda_build/bin/llama-server\", \"./llama-cuda\")\n",
    "    print(\"✅ llama-cuda built successfully\")\n",
    "else:\n",
    "    print(\"✅ llama-cuda already built\")\n",
    "\n",
    "print(\"✅ CELL 2 complete - model and server ready\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "# =====================================================================\n",
    "# CELL 3: Start server + Cloudflare tunnel\n",
    "# =====================================================================\n",
    "import os, subprocess, time\n",
    "\n",
    "os.chdir(\"/kaggle/working/Apex_oracle_bot/kaggle_llm_pipeline\")\n",
    "\n",
    "# Start llama-server (detached, logs to server.log)\n",
    "server_cmd = [\n",
    "    \"./llama-cuda\",\n",
    "    \"-m\", \"/kaggle/working/models/qwen3-coder-32b-q5_k_m.gguf\",\n",
    "    \"--split-mode\", \"layer\",\n",
    "    \"--tensor-split\", \"1,1\",\n",
    "    \"-ngl\", \"999\",\n",
    "    \"-c\", \"32768\",\n",
    "    \"--cache-type-k\", \"q8_0\",\n",
    "    \"--cache-type-v\", \"q8_0\",\n",
    "    \"--jinja\",\n",
    "    \"--host\", \"0.0.0.0\",\n",
    "    \"--port\", \"8080\"\n",
    "]\n",
    "\n",
    "print(\"🚀 Starting llama-server...\")\n",
    "with open(\"server.log\", \"w\") as f:\n",
    "    server_proc = subprocess.Popen(server_cmd, stdout=f, stderr=subprocess.STDOUT)\n",
    "\n",
    "# Wait for server to load model (1-2 min)\n",
    "print(\"⏳ Waiting for model to load on GPUs...\")\n",
    "for i in range(24):  # 2 min max\n",
    "    time.sleep(5)\n",
    "    with open(\"server.log\", \"r\") as f:\n",
    "        log = f.read()\n",
    "    if \"listening on http://0.0.0.0:8080\" in log:\n",
    "        print(\"✅ llama-server is listening on port 8080\")\n",
    "        break\n",
    "    if \"offloaded 49/49 layers to GPU\" in log:\n",
    "        print(f\"  ... GPU offload in progress (attempt {i+1}/24)\")\n",
    "else:\n",
    "    print(\"⚠️ Server startup taking longer than expected. Check server.log\")\n",
    "\n",
    "# Start Cloudflare tunnel (detached)\n",
    "print(\"🌐 Starting Cloudflare tunnel...\")\n",
    "tunnel_cmd = [\"./cloudflared\", \"tunnel\", \"--url\", \"http://localhost:8080\", \"--no-autoupdate\"]\n",
    "with open(\"tunnel.log\", \"w\") as f:\n",
    "    subprocess.Popen(tunnel_cmd, stdout=f, stderr=subprocess.STDOUT)\n",
    "\n",
    "print(\"⏳ Waiting for tunnel URL...\")\n",
    "for i in range(20):\n",
    "    time.sleep(2)\n",
    "    if os.path.exists(\"tunnel.log\"):\n",
    "        with open(\"tunnel.log\", \"r\") as f:\n",
    "            log = f.read()\n",
    "        import re\n",
    "        urls = re.findall(r\"https://[a-z0-9-]*\\.trycloudflare\\.com\", log)\n",
    "        if urls:\n",
    "            tunnel_url = urls[-1]\n",
    "            print(f\"\\n🎉 TUNNEL URL: {tunnel_url}\")\n",
    "            print(f\"\\n📋 COPY THIS URL AND RUN ON ORACLE:\")\n",
    "            print(f\"   kaggle-url {tunnel_url}\")\n",
    "            break\n",
    "else:\n",
    "    print(\"⚠️ Tunnel URL not found yet. Check tunnel.log\")\n",
    "\n",
    "# Verify server health\n",
    "import urllib.request\n",
    "try:\n",
    "    resp = urllib.request.urlopen(\"http://localhost:8080/health\", timeout=5)\n",
    "    print(f\"✅ Server health check: {resp.read().decode()}\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Health check failed: {e}\")\n",
    "\n",
    "print(\"\\n✅ CELL 3 complete - Server + Tunnel running!\")\n",
    "print(\"   Keep this cell running to keep the server/tunnel alive\")"
   ]
  },
