    "# =====================================================================\n",
    "# CELL 5: Status check (run anytime to verify health)\n",
    "# =====================================================================\n",
    "import os, subprocess\n",
    "\n",
    "print(\"=== KAGGLE LLM STATUS ===\")\n",
    "\n",
    "# 1. Check if server process is running\n",
    "result = subprocess.run([\"pgrep\", \"-f\", \"llama-cuda\"], capture_output=True, text=True)\n",
    if result.returncode == 0:\n",
    "    print(f\"✅ llama-server: RUNNING (PID: {result.stdout.strip()})\")\n",
    "else:\n",
    "    print(\"❌ llama-server: NOT RUNNING\")\n",
    "\n",
    "# 2. Check if tunnel is running\n",
    "result = subprocess.run([\"pgrep\", \"-f\", \"cloudflared\"], capture_output=True, text=True)\n",
    if result.returncode == 0:\n",
    "    print(f\"✅ cloudflared tunnel: RUNNING (PID: {result.stdout.strip()})\")\n",
    "else:\n",
    "    print(\"❌ cloudflared tunnel: NOT RUNNING\")\n",
    "\n",
    "# 3. Check local server health\n",
    "import urllib.request\n",
    "try:\n",
    "    with urllib.request.urlopen(\"http://localhost:8080/health\", timeout=3) as resp:\n",
    "        print(f\"✅ Local server health: {resp.read().decode()}\")\n",
    "except Exception as e:\n",
    "    print(f\"❌ Local server: {e}\")\n",
    "\n",
    "# 4. Check tunnel URL from logs\n",
    "import re\n",
    "if os.path.exists(\"tunnel.log\"):\n",
    "    with open(\"tunnel.log\", \"r\") as f:\n",
    "        log = f.read()\n",
    "    urls = re.findall(r\"https://[a-z0-9-]*\\.trycloudflare\\.com\", log)\n",
    "    if urls:\n",
    "        print(f\"🌐 Current tunnel URL: {urls[-1]}\")\n",
    "        print(f\"   Oracle command: kaggle-url {urls[-1]}\")\n",
    "    else:\n",
    "        print(\"❌ No tunnel URL found in logs\")\n",
    "else:\n",
    "    print(\"❌ tunnel.log not found\")"
   ]
  }
