    "# =====================================================================\n",
    "# CELL 4: Verification & Oracle connection test (run after Cell 3)\n",
    "# =====================================================================\n",
    "import urllib.request, json, time\n",
    "\n",
    "# Get the tunnel URL from tunnel.log\n",
    "import re, os\n",
    "if os.path.exists(\"tunnel.log\"):\n",
    "    with open(\"tunnel.log\", \"r\") as f:\n",
    "        log = f.read()\n",
    "    urls = re.findall(r\"https://[a-z0-9-]*\\.trycloudflare\\.com\", log)\n",
    "    if urls:\n",
    "        tunnel_url = urls[-1]\n",
    "        print(f\"Tunnel URL: {tunnel_url}\")\n",
    "        \n",
    "        # Test health endpoint\n",
    "        try:\n",
    "            with urllib.request.urlopen(f\"{tunnel_url}/health\", timeout=10) as resp:\n",
    "                print(f\"✅ Tunnel health: {resp.read().decode()}\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Tunnel health failed: {e}\")\n",
    "        \n",
    "        # Test chat completion\n",
    "        test_payload = {\n",
    "            \"model\": \"qwen3-coder\",\n",
    "            \"messages\": [{\"role\": \"user\", \"content\": \"Say hello from Kaggle GPU!\"}],\n",
    "            \"max_tokens\": 20,\n",
    "            \"stream\": True\n",
    "        }\n",
    "        \n",
    "        print(\"\\n🧪 Testing chat completion with streaming...\")\n",
    "        req = urllib.request.Request(\n",
    "            f\"{tunnel_url}/v1/chat/completions\",\n",
    "            data=json.dumps(test_payload).encode(),\n",
    "            headers={\"Content-Type\": \"application/json\"}\n",
    "        )\n",
    "        try:\n",
    "            with urllib.request.urlopen(req, timeout=30) as resp:\n",
    "                for line in resp:\n",
    "                    line = line.decode().strip()\n",
    "                    if line.startswith(\"data: \") and \"[DONE]\" not in line:\n",
    "                        try:\n",
    "                            chunk = json.loads(line[6:])\n",
    "                            content = chunk[\"choices\"][0][\"delta\"].get(\"content\", \"\")\n",
    "                            if content:\n",
    "                                print(content, end=\"\", flush=True)\n",
    "                        except:\n",
    "                            pass\n",
    "        print(\"\\n✅ Streaming test complete!\")\n",
    "    else:\n",
    "        print(\"❌ No tunnel URL found in tunnel.log\")"
   ]
