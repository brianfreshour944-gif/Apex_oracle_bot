{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "apex-manager",
  "instructions": [
    "AGENTS.md",
    "OPENCODE_AGENT_WORKFLOW.md",
    "AIR_AGENT_WORKFLOW.md"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "docker compose down -v*": "deny",
      "docker volume rm *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    },
    "external_directory": "ask",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
